# Supabase Configuration
# SUPABASE_URL matches the parent project's .env.local.
#
# SUPABASE_KEY MUST be the service_role key, not the anon key. The events
# tables have RLS enabled with read-only public policies, so the anon key
# cannot insert or update and every write will fail with error 42501.
# Find it in Supabase: Settings > API > service_role. It bypasses RLS —
# keep it server-side only and never commit it or expose it to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key-here

# Calendar Sources
# NORCALSCI_CALENDAR_URL=https://norcalsci.org/calendar

# Logging
LOG_LEVEL=info
DEBUG=false

# Feed Configuration
SCRAPER_TIMEOUT=30000
SCRAPER_HEADLESS=true
BATCH_SIZE=50
